# ==============================================================================
# Liquid Audio — BUILD V1 Environment Variables Example
# Copy to `.env` and customize for your own self-hosted Navidrome setup.
# Never commit your real `.env` file to GitHub.
# ==============================================================================

# --- Frontend (Vite build-time, optional) ---
# Optional default Navidrome URL prefilled on first visit (leave blank to prompt user)
VITE_DEFAULT_NAVIDROME_URL=
# Optional backend API base URL (leave blank when served through the bundled nginx proxy)
VITE_API_BASE_URL=

# --- Backend / Transcriber (Docker runtime, optional) ---
# Path to Navidrome SQLite database inside the container (mounted read-only if used)
NAVIDROME_DB=/data/navidrome.db
# Public URL of your Liquid Audio instance (used for generated share links & Discord RPC bridge)
PUBLIC_PLAYER_URL=https://player.example.com

# --- Optional: Custom Song-Sharing File Server (e.g. FileBrowser) ---
# Leave blank if you do not want public file-share links enabled.
FILEBROWSER_PUBLIC_BASE=
FILEBROWSER_KEY_B64=
